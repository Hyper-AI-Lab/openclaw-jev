{
  "id": "rmp_adapter",
  "name": "Reliability and Memory Plane Adapter",
  "version": "1.0.0",
  "description": "RMP task management tools for OpenClaw.",
  "main": "index.js",
  "configSchema": {
    "type": "object",
    "properties": {
      "enabled": {
        "type": "boolean",
        "default": true
      }
    }
  },
  "activation": {
    "onStartup": true
  },
  "contracts": {
    "tools": [
      "rmp_memory_recall",
      "rmp_task_create",
      "rmp_task_status"
    ]
  }
}
