[Unit]
Description=Aura Obscura CDP browser (Docker)
After=network.target docker.service
Requires=docker.service

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/root/.openclaw/web-stack
ExecStart=/usr/bin/docker-compose up -d obscura
ExecStop=/usr/bin/docker-compose stop obscura
TimeoutStartSec=300

[Install]
WantedBy=multi-user.target
