[Unit]
Description=RMP Temporal worker
After=openclaw-gateway.service rmp-api.service temporal.service rmp-qdrant.service
Requires=temporal.service
Wants=openclaw-gateway.service rmp-api.service rmp-qdrant.service

[Service]
Type=simple
User=root
WorkingDirectory=/root/.openclaw/rmp
Environment=PYTHONPATH=/root/.openclaw/rmp
EnvironmentFile=-/etc/rmp/rmp.env
EnvironmentFile=-/etc/openclaw/openclaw.env
ExecStartPre=/root/.openclaw/rmp/venv/bin/python /root/.openclaw/rmp/ops/sync_nvidia_keys.py
ExecStartPre=/bin/bash /root/.openclaw/rmp/ops/wait_temporal.sh
ExecStart=/root/.openclaw/rmp/venv/bin/python worker.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
